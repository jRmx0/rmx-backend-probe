# Local development settings. Copy to .env (gitignored) and adjust:
#   Copy-Item .env.example .env
# These are dev-only passwords for the local compose stack (bound to 127.0.0.1).
# On the VPS the real values live in a server-side .env, never in git.

# --- probe-server -----------------------------------------------------------
BIND_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://probe:probe-dev@127.0.0.1:55432/probe
MQTT_HOST=127.0.0.1
MQTT_PORT=11883
MQTT_USERNAME=probe-app
MQTT_PASSWORD=probe-app-dev
# Pages allowed to log in, change data and open the WebSocket (CSRF check):
# the Bun dev server, and probe-server itself when it serves the built client.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080
RUST_LOG=info,probe_server=debug,tower_http=info

# --- build -------------------------------------------------------------------
# sqlx checks queries at compile time. With this set it uses the committed
# .sqlx/ data (like Docker and CI), so building needs no running database.
# After changing a query, run `cargo sqlx prepare` (see README).
SQLX_OFFLINE=true

# --- compose.dev.yaml -------------------------------------------------------
POSTGRES_PASSWORD=probe-dev
# Password of the MQTT login probe-device (a device, used by the integration tests).
PROBE_DEVICE_PASSWORD=probe-device-dev
