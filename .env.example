# Local development settings. Copy to .env (gitignored) and adjust:
#   Copy-Item .env.example .env
# These are dev-only passwords for the local compose stack (bound to 127.0.0.1).
# On the VPS the real values live in a server-side .env, never in git.

# --- probe-server -----------------------------------------------------------
BIND_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://probe:probe-dev@127.0.0.1:55432/probe
MQTT_HOST=127.0.0.1
MQTT_PORT=11883
MQTT_USERNAME=probe-app
MQTT_PASSWORD=probe-app-dev
# The broker's WebSocket URL as the browser sees it (served in /probe/config.json).
MQTT_WS_URL=ws://127.0.0.1:19001
RUST_LOG=info,probe_server=debug,tower_http=info

# --- compose.dev.yaml -------------------------------------------------------
POSTGRES_PASSWORD=probe-dev
# Password of the browser login probe-web (typed into the UI, never built in).
PROBE_WEB_PASSWORD=probe-web-dev
