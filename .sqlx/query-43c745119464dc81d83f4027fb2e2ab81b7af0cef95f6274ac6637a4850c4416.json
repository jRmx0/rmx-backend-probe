{
  "db_name": "PostgreSQL",
  "query": "SELECT s.user_id, u.username,\n                      s.last_seen_at < now() - make_interval(secs => $3) AS \"stale!\"\n               FROM sessions s JOIN users u ON u.id = s.user_id\n               WHERE s.id_hash = $1\n                 AND s.expires_at > now()\n                 AND s.last_seen_at > now() - make_interval(secs => $2)",
